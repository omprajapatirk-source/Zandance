// ============================================================================
//  Zandance (Nyx) — Privacy-Preserving Fee Abstraction & DUST Sponsorship Router
//  Target Platform: Midnight Network (Preprod / Preview)
//  Language: Compact (v0.23+)
// ============================================================================

pragma language_version >= 0.23;

import CompactStandardLibrary;

// ----------------------------------------------------------------------------
// 1. Private Witnesses (Off-chain private inputs, never revealed on ledger)
// ----------------------------------------------------------------------------

// Private user secret key or nullifier seed
witness getSenderSecret(): Bytes<32>;

// Private cross-chain payload details (shielded sender address, target recipient)
witness getIntentPayload(): Bytes<32>;

// Private shielded asset balance verification
witness getShieldedBalance(): Uint<64>;

// ----------------------------------------------------------------------------
// 2. Public Ledger State (On-chain state visible to network observers)
// ----------------------------------------------------------------------------

// Protocol administrator / Pool operator
export ledger admin: Bytes<32>;

// Current DUST reserve capacity held by the protocol pool
export ledger dustPoolReserve: Uint<64>;

// Total count of gasless transactions sponsored
export ledger totalSponsoredTransactions: Uint<64>;

// Total cumulative DUST sponsored to date
export ledger totalDustSponsored: Uint<64>;

// Current decay accounting epoch
export ledger currentEpoch: Uint<64>;

// Active registered relayers authorized to execute destination gas
export ledger activeRelayers: Map<Bytes<32>, Boolean>;

// Committed intent authorizations (intentHash -> maxFeeAuthorized)
export ledger intentCommitments: Map<Bytes<32>, Uint<64>>;

// Settled intents mapping to prevent double-spending & replay attacks
export ledger settledIntents: Map<Bytes<32>, Boolean>;

// ----------------------------------------------------------------------------
// 3. Zero-Knowledge Circuits (Contract Logic & State Transitions)
// ----------------------------------------------------------------------------

/**
 * Initializes the Zandance router and sets the protocol admin.
 */
export circuit initialize(initialAdmin: Bytes<32>, initialReserve: Uint<64>): [] {
    admin = disclose(initialAdmin);
    dustPoolReserve = disclose(initialReserve);
    totalSponsoredTransactions = 0;
    totalDustSponsored = 0;
    currentEpoch = 1;
}

/**
 * Registers an authorized cross-chain fee relayer.
 */
export circuit registerRelayer(relayerPubkey: Bytes<32>): [] {
    activeRelayers.insert(disclose(relayerPubkey), true);
}

/**
 * De-registers a cross-chain fee relayer.
 */
export circuit deregisterRelayer(relayerPubkey: Bytes<32>): [] {
    activeRelayers.insert(disclose(relayerPubkey), false);
}

/**
 * Deposit fresh DUST generated by protocol-staked NIGHT into the sponsorship pool.
 */
export circuit depositDustReserve(amount: Uint<64>): [] {
    assert amount > 0 "Deposit amount must be positive";
    dustPoolReserve = dustPoolReserve + disclose(amount);
}

/**
 * Apply Midnight DUST decay mechanic to the liquidity pool according to epoch rules.
 * This ensures stale fee capacity is properly aged out rather than artificially hoarded.
 */
export circuit applyDustDecay(decayAmount: Uint<64>): [] {
    assert decayAmount <= dustPoolReserve "Decay cannot exceed reserve";
    dustPoolReserve = dustPoolReserve - disclose(decayAmount);
    currentEpoch = currentEpoch + 1;
}

/**
 * Sponsor Fee Intent Circuit (Zero-Knowledge Privacy Core)
 *
 * Privacy Invariant:
 * - The user's secret key (`getSenderSecret`) and payload (`getIntentPayload`)
 *   remain strictly inside the private witness.
 * - Only the cryptographic `intentHash` and `maxFee` are explicitly disclosed.
 * - An observer sees DUST being allocated, but cannot determine who the shielded
 *   sender is or what transaction data is shielded inside Midnight.
 */
export circuit sponsorFeeIntent(intentHash: Bytes<32>, maxFee: Uint<64>): [] {
    // 1. Verify DUST liquidity pool has sufficient balance
    assert dustPoolReserve >= maxFee "Insufficient DUST in sponsorship pool";

    // 2. Fetch private witness values (shielded computation)
    const secret = getSenderSecret();
    const payload = getIntentPayload();
    const userBalance = getShieldedBalance();

    // 3. Enforce private constraints inside ZK circuit
    // User must have enough shielded balance for the source fee equivalent
    assert userBalance >= maxFee "Shielded funds insufficient for fee intent";

    // Enforce that the commitment is non-zero
    assert maxFee > 0 "Fee must be greater than zero";

    // 4. Reserve DUST allocation from pool
    dustPoolReserve = dustPoolReserve - maxFee;

    // 5. Deliberately disclose the public commitment to the ledger
    intentCommitments.insert(disclose(intentHash), disclose(maxFee));
    totalSponsoredTransactions = totalSponsoredTransactions + 1;
}

/**
 * Relayer Claim Reimbursement Circuit
 *
 * Once the relayer has submitted the destination transaction, they claim
 * settlement proof on Midnight, marking the intent settled.
 */
export circuit claimReimbursement(
    intentHash: Bytes<32>,
    feeSpent: Uint<64>,
    relayerPubkey: Bytes<32>
): [] {
    // 1. Relayer must be registered and active
    const isRelayerActive = activeRelayers.lookup(relayerPubkey);
    assert isRelayerActive == true "Unauthorized or inactive relayer";

    // 2. Intent must not have already been settled (Replay Protection)
    const alreadySettled = settledIntents.lookup(intentHash);
    assert alreadySettled == false "Intent already settled";

    // 3. Verify fee spent is within the committed bound
    const committedMaxFee = intentCommitments.lookup(intentHash);
    assert committedMaxFee >= feeSpent "Spent fee exceeds authorized maximum";

    // 4. Mark intent settled on public ledger
    settledIntents.insert(disclose(intentHash), true);

    // 5. Update cumulative sponsored metrics
    totalDustSponsored = totalDustSponsored + disclose(feeSpent);

    // 6. Refund any unused DUST back to the liquidity pool
    const unusedDust = committedMaxFee - feeSpent;
    if (unusedDust > 0) {
        dustPoolReserve = dustPoolReserve + unusedDust;
    }
}
